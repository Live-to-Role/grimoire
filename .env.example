# Library Configuration
# Which folders get scanned is managed via the Settings UI, using the container
# paths below. These variables control what the Docker stack bind-mounts.
#
# Windows example: PDF_LIBRARY_PATH=D:/RPG/PDFs
# macOS example:   PDF_LIBRARY_PATH=/Users/yourname/Documents/RPG
# Linux example:   PDF_LIBRARY_PATH=/home/yourname/rpg-library
#
# They mount at /library, /library2 and /library3 respectively. Unset paths
# fall back to ./pdfs. In Settings, add the container path, not the host path.
PDF_LIBRARY_PATH=
PDF_LIBRARY_PATH_2=
PDF_LIBRARY_PATH_3=

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/grimoire.db

# AI Providers (optional - leave empty to disable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Processing
MAX_CONCURRENT_PROCESSING=3
COVER_THUMBNAIL_SIZE=300

# Security
SECRET_KEY=change-this-in-production

# Codex API (optional - for syncing to Codex database)
CODEX_API_URL=https://codex-api.livetorole.com/api/v1
CODEX_API_KEY=
CODEX_CONTRIBUTE_ENABLED=false
CODEX_TIMEOUT=10

# OCR (optional - set paths if not on system PATH)
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS/Linux: leave empty to use system PATH
TESSERACT_CMD=
# Poppler (required for OCR - pdf2image needs pdftoppm)
# Windows: POPPLER_PATH=C:\poppler\Library\bin
# macOS/Linux: leave empty to use system PATH
POPPLER_PATH=
